{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/00MY00/WorkflowPacks/schema/freescout-workflow-pack.schema.json",
    "title": "FreeScout Workflow Pack — schéma version 1",
    "description": "Ensemble de règles du module Workflows de FreeScout, importable par le module Workflow Packs. Les types, opérateurs et valeurs des conditions et actions sont vérifiés à l'import contre le catalogue réel du module Workflows de l'instance (Gérer › Workflow Packs › Diagnostic). Les valeurs peuvent contenir {{mailbox.id}}, {{mailbox.email}}, {{mailbox.name}} et {{param.<clé>}}, remplacées à l'import (jamais évaluées).",
    "type": "object",
    "required": ["format", "version", "key", "name", "workflows"],
    "additionalProperties": false,
    "patternProperties": { "^x-": {} },
    "properties": {
        "$schema": { "type": "string" },
        "format": { "const": "freescout-workflow-pack" },
        "version": { "const": 1, "description": "Version du schéma du fichier (pas la version du pack)." },
        "key": { "$ref": "#/$defs/key", "description": "Identifiant stable du pack : sert à reconnaître ses règles lors des mises à jour." },
        "name": { "type": "string", "minLength": 1, "maxLength": 191 },
        "description": { "type": "string", "maxLength": 5000 },
        "pack_version": { "type": "string", "maxLength": 50, "description": "Version du contenu du pack (ex. 1.2.0)." },
        "requires": { "$ref": "#/$defs/requires", "description": "Modules requis par toutes les règles." },
        "params": {
            "type": "array",
            "maxItems": 50,
            "items": { "$ref": "#/$defs/param" }
        },
        "workflows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": { "$ref": "#/$defs/workflow" }
        }
    },
    "$defs": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
        "requires": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,50}$" },
            "description": "Alias de modules FreeScout (ex. \"tags\"). Module inactif : règle bloquée, jamais modifiée pour la rendre importable."
        },
        "param": {
            "type": "object",
            "required": ["key"],
            "additionalProperties": false,
            "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,49}$" },
                "label": { "type": "string" },
                "description": { "type": "string" },
                "type": { "enum": ["string", "email", "integer", "user", "mailbox"], "default": "string", "description": "user / mailbox : identifiant local vérifié à l'import, sans valeur par défaut." },
                "required": { "type": "boolean", "default": false },
                "default": { "type": ["string", "integer"] },
                "sensitive": { "type": "boolean", "default": false, "description": "Valeur jamais conservée par Workflow Packs ni exportée." }
            }
        },
        "workflow": {
            "type": "object",
            "required": ["key", "name", "actions"],
            "additionalProperties": false,
            "properties": {
                "key": { "$ref": "#/$defs/key", "description": "Identifiant stable de la règle dans le pack." },
                "name": { "type": "string", "minLength": 1, "description": "75 caractères au plus après remplacement des variables (limite de Workflows), unique dans la boîte." },
                "description": { "type": "string" },
                "type": { "enum": ["automatic", "manual"], "default": "automatic" },
                "settings": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "apply_to_prev": { "type": "boolean", "default": false, "description": "Appliquer aux conversations précédentes. Ignoré à l'import sauf option explicite." },
                        "max_executions": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 }
                    }
                },
                "requires": { "$ref": "#/$defs/requires" },
                "conditions": { "$ref": "#/$defs/conditions" },
                "actions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": { "$ref": "#/$defs/action" }
                }
            },
            "if": { "properties": { "type": { "const": "manual" } }, "required": ["type"] },
            "else": { "required": ["conditions"] }
        },
        "conditions": {
            "description": "Seules les formes représentables par Workflows : {\"all\": [condition | {\"any\": [condition…]}…]} (ET de groupes OU) ou {\"any\": [condition…]} (un seul groupe OU).",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["all"],
                    "additionalProperties": false,
                    "properties": {
                        "all": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 20,
                            "items": { "oneOf": [{ "$ref": "#/$defs/condition" }, { "$ref": "#/$defs/anyGroup" }] }
                        }
                    }
                },
                { "$ref": "#/$defs/anyGroup" }
            ]
        },
        "anyGroup": {
            "type": "object",
            "required": ["any"],
            "additionalProperties": false,
            "properties": {
                "any": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/condition" } }
            }
        },
        "condition": {
            "type": "object",
            "required": ["type", "operator"],
            "additionalProperties": false,
            "properties": {
                "type": { "type": "string", "minLength": 1, "description": "Identifiant de Workflow::conditionsConfig() (ex. subject, customer_email, new_or_reply)." },
                "operator": { "type": "string", "minLength": 1, "description": "Opérateur proposé pour ce type (ex. contains, equal, regex)." },
                "value": { "description": "Avec l'opérateur regex : motif PCRE avec délimiteurs (ex. \"/facture/iu\") ; les variables y sont insérées comme texte littéral." }
            }
        },
        "action": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
                "type": { "type": "string", "minLength": 1, "description": "Identifiant de Workflow::actionsConfig() (ex. note, status, forward)." },
                "operator": { "type": "string" },
                "value": { "description": "Pour note, reply, email_customer et forward : objet (body, to, cc, bcc, subject), stocké en JSON par Workflows ; « body » est du HTML (variables échappées)." }
            }
        }
    }
}
